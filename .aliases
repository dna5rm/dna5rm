alias _listen="lsof -nP -iTCP -sTCP:LISTEN | sed '1 s,.*,$(tput smso)&$(tput sgr0),'"
alias less='less --RAW-CONTROL-CHARS'
alias jq_walk="jq -rc '[paths|map((\".\"+strings)//\"[]\")|join(\"\")]|unique[]'"
alias rot13="tr a-zA-Z n-za-mN-ZA-M"

# terraform
type terraform >/dev/null 2>&1 && {
    alias tf=terraform
    alias tf_apply='terraform apply -auto-approve'
    alias tf_destroy='terraform apply -auto-approve -destroy'
    alias tf_output='terraform output -json'
}

# Rancid chromaterm+cloginrc
type clogin >/dev/null 2>&1 && { alias clogin="ct clogin -f \"${TMPDIR}/.cloginrc\""; }

# Directory listing: ls/lsd
type lsd >/dev/null 2>&1 && {
    alias ls='lsd'
    alias tree='lsd --tree'
} || {
    alias ls='ls --color=auto' 2>/dev/null
}

# Do not alias cat/nmap — keep real tools. bat/figlet if present as themselves.
type nano >/dev/null 2>&1 && { alias pico=nano; }
type ollama.exe >/dev/null 2>&1 && { alias ollama=ollama.exe; }
type bat >/dev/null 2>&1 && { alias bat='bat --paging=never'; }

# Compat: old PowerShell-verb names → unix functions (interactive only)
alias Run-Command='run_command'
alias Get-Vault='vault_get'
alias Edit-Vault='vault_edit'
alias Initialize-Vault='vault_init'
alias Protect-Vault='vault_protect'
alias Unprotect-Vault='vault_unprotect'
alias Get-Hash='get_hash'
alias Get-SshKeyFingerprint='ssh_fingerprint'
alias Ensure-Pip='ensure_pip'
alias Set-Clipboard='clip_set'
alias Get-Clipboard='clip_get'
alias New-Password='new_password'
alias Assert-ContainsElement='assert_in'
alias Assert-StrIsDns='assert_dns'
alias Assert-StrIsEmail='assert_email'
alias Assert-StrIsIpv4='assert_ipv4'
alias Assert-StrIsCidr='assert_cidr'
alias Assert-Command='assert_cmd'
alias Assert-File='assert_file'
alias Assert-Dir='assert_dir'
alias Initialize-Gpg='gpg_init'
alias Backup-Gpg='gpg_backup'
alias Restore-Gpg='gpg_restore'
alias Get-GpgKey='gpg_ls'
alias Import-Gpg='gpg_import'
alias Export-Gpg='gpg_export'
alias Protect-Gpg='gpg_encrypt'
alias Unprotect-Gpg='gpg_decrypt'
alias Protect-GpgString='gpg_encrypt_str'
alias Unprotect-GpgString='gpg_decrypt_str'
