# GNU Screen 4.09 — portable dna5rm rc
# Serial consoles: open on demand (auto-spawn hangs if the tty is missing).

### Options ###
altscreen on
autodetach on
defutf8 on
defencoding utf8
defscrollback 16384
shelltitle ''
startup_message off
vbell off
shell -$SHELL
activity 'Activity on screen %n ^G'

### Status ###
hardstatus alwayslastline
hardstatus string '%{= kK} %{= KC}%u@%H %{= kK}|%-w%{= kC} %n %t %{= kK}%+w %= %{= KG}%l %{= kK} %{= KW}%M-%d %0c %{= kK} '

### Windows ###
# Window 0 is the login shell; C-a c takes the next free number.
screen -t shell 0

# C-a :  screen -t usb0  10 /dev/ttyUSB0
# C-a :  screen -t pa440 11 /dev/ttyUSB1
# C-a :  screen -t c3560 12 /dev/ttyUSB2
# C-a :  screen -t c9115 13 /dev/ttyUSB3
# Default serial is 9600 8N1; append a baud after the device if needed.

### Keys ###
bindkey "^[[1;5C" next
bindkey "^[[1;5D" prev

### Terminal ###
term screen-256color
terminfo rxvt-unicode 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
